{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/*.mjs": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600"
        },
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/html.*"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/api/contents",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=120, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/api/lecture",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=120, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/api/batches",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=1200"
        }
      ]
    },
    {
      "source": "/api/batch",
      "has": [
        {
          "type": "query",
          "key": "today",
          "value": "1"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=30, stale-while-revalidate=30"
        }
      ]
    },
    {
      "source": "/api/batch",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=1200"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/pw/:path*",
      "destination": "/api/pw?path=:path*"
    },
    {
      "source": "/api/sign/:path*",
      "destination": "/api/admin?action=sign&path=:path*"
    },
    {
      "source": "/api/sign",
      "destination": "/api/admin?action=sign"
    },
    {
      "source": "/api/hls/:path*",
      "destination": "/api/stream?action=hls&path=:path*"
    },
    {
      "source": "/api/hls",
      "destination": "/api/stream?action=hls"
    },
    {
      "source": "/api/repair",
      "destination": "/api/admin?action=repair"
    },
    {
      "source": "/api/scan",
      "destination": "/api/admin?action=scan"
    },
    {
      "source": "/api/client-error",
      "destination": "/api/admin?action=client-error"
    },
    {
      "source": "/api/download",
      "destination": "/api/stream?action=download"
    }
  ],
  "crons": [
    {
      "path": "/api/admin?action=scan&cron=1",
      "schedule": "0 3 * * *"
    }
  ]
}
