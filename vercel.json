{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/*.mjs": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/api/batches",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=1200"
        }
      ]
    },
    {
      "source": "/api/batch",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=1200"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/pw/:path*",
      "destination": "/api/pw?path=:path*"
    },
    {
      "source": "/api/sign/:path*",
      "destination": "/api/admin?action=sign&path=:path*"
    },
    {
      "source": "/api/sign",
      "destination": "/api/admin?action=sign"
    },
    {
      "source": "/api/hls/:path*",
      "destination": "/api/stream?action=hls&path=:path*"
    },
    {
      "source": "/api/hls",
      "destination": "/api/stream?action=hls"
    },
    {
      "source": "/api/repair",
      "destination": "/api/admin?action=repair"
    },
    {
      "source": "/api/download",
      "destination": "/api/stream?action=download"
    }
  ]
}
